<UserControl
    x:Class="DordieWatch.App.Views.PlayerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DordieWatch.App.ViewModels"
    xmlns:vlc="using:LibVLCSharp.Avalonia"
    x:DataType="vm:PlayerViewModel">

  <UserControl.Styles>
    <Style Selector="Button.playerIcon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="58" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.playerIcon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.playerIcon:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Slider.playerTimeline">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Foreground" Value="#E50914" />
      <Setter Property="Background" Value="#A0FFFFFF" />
    </Style>
  </UserControl.Styles>

  <Grid Background="#000000">
    <vlc:VideoView MediaPlayer="{Binding MediaPlayer}" />

    <Grid RowDefinitions="Auto,*,Auto" Background="Transparent">
      <Button
          Grid.Row="0"
          Classes="playerIcon"
          Command="{Binding BackCommand}"
          HorizontalAlignment="Left"
          Margin="18,18,0,0"
          Width="54"
          Height="54">
        <Viewbox Width="38" Height="38">
          <Path Stroke="#FFFFFF" StrokeThickness="2.3" StrokeLineCap="Round" Fill="Transparent"
                Data="M 22 7 L 9 20 L 22 33 M 10 20 L 36 20" />
        </Viewbox>
      </Button>

      <StackPanel Grid.Row="2" Margin="20,0,20,16" Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <Slider
              Grid.Column="0"
              Classes="playerTimeline"
              Value="{Binding PositionSeconds, Mode=TwoWay}"
              Maximum="{Binding DurationSeconds}" />
          <TextBlock
              Grid.Column="1"
              Text="{Binding TimeText}"
              FontSize="13"
              FontWeight="SemiBold"
              Margin="12,0,0,0"
              VerticalAlignment="Center" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto,*">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
            <Button Classes="playerIcon" Command="{Binding TogglePauseCommand}">
              <Grid Width="44" Height="44">
                <Path
                    IsVisible="{Binding !IsPlaying}"
                    Fill="#FFFFFF"
                    Stretch="Uniform"
                    Data="M 7 3 L 38 22 L 7 41 Z" />
                <Grid IsVisible="{Binding IsPlaying}" ColumnDefinitions="*,*" Width="30" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="1" Width="9" />
                  <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="1" Width="9" />
                </Grid>
              </Grid>
            </Button>

            <Button Classes="playerIcon">
              <Grid Width="44" Height="44">
                <Path Stroke="#FFFFFF" StrokeThickness="2.7" StrokeLineCap="Round" Fill="Transparent"
                      Data="M 18 8 A 15 15 0 1 0 31 14 M 18 8 L 18 2 M 18 8 L 10 8" />
                <TextBlock Text="10" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button Classes="playerIcon">
              <Grid Width="44" Height="44">
                <Path Stroke="#FFFFFF" StrokeThickness="2.7" StrokeLineCap="Round" Fill="Transparent"
                      Data="M 26 8 A 15 15 0 1 1 13 14 M 26 8 L 26 2 M 26 8 L 34 8" />
                <TextBlock Text="10" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button Classes="playerIcon">
              <Viewbox Width="42" Height="42">
                <Path Stroke="#FFFFFF" StrokeThickness="2.2" StrokeLineCap="Round" Fill="Transparent"
                      Data="M 5 17 L 13 17 L 23 8 L 23 34 L 13 25 L 5 25 Z M 29 16 C 32 19 32 23 29 26 M 34 11 C 40 17 40 25 34 31" />
              </Viewbox>
            </Button>
          </StackPanel>

          <TextBlock
              Grid.Column="1"
              Text="{Binding Title}"
              FontSize="15"
              FontWeight="SemiBold"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="18,0" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <Button Classes="playerIcon">
              <Viewbox Width="40" Height="40">
                <Path Stroke="#FFFFFF" StrokeThickness="2.4" StrokeLineCap="Round" Fill="Transparent"
                      Data="M 8 10 L 32 10 L 32 27 L 18 27 L 11 33 L 13 27 L 8 27 Z M 14 17 L 20 17 M 23 17 L 29 17 M 14 22 L 20 22 M 23 22 L 29 22" />
              </Viewbox>
            </Button>

            <Button Classes="playerIcon">
              <Viewbox Width="40" Height="40">
                <Path Stroke="#FFFFFF" StrokeThickness="2.4" StrokeLineCap="Round" Fill="Transparent"
                      Data="M 7 16 L 7 7 L 16 7 M 24 7 L 33 7 L 33 16 M 7 24 L 7 33 L 16 33 M 24 33 L 33 33 L 33 24" />
              </Viewbox>
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
