# Build output
bin/
obj/
publish/
**/bin/
**/obj/

# Local video libraries - never commit media files
videos/
**/videos/
*.mkv
*.mp4
*.avi
*.mov
*.webm
*.m4v

# Subtitle files can contain downloaded/private media metadata; keep local by default
*.ass
*.ssa
*.srt

# App/runtime caches
.appdata/
.dotnet/
.dotnet_home/
.nuget/
.tmp_reference_frames/
host-trace.txt
*.log
*.db
*.sqlite
*.sqlite3

# IDE/user-local files
.vs/
.idea/
*.user
*.suo
*.rsuser
