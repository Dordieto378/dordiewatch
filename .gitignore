__pycache__/
*.py[cod]
build/
dist/
*.spec
.agents/
.codex/
.pytest_cache/

# Local media library - never commit actual videos.
videos/*
!videos/.gitkeep
*.mkv
*.mp4
*.avi
*.mov
*.webm
*.wmv
*.flv
*.m4v
*.ts
*.m2ts

# Generated/extracted subtitle cache.
subtitles/
*.ass.tmp

# Local binary runtime/dependency payloads.
runtime/
vendor/
*.dll
*.exe

# Local/private font files. The app no longer needs this folder.
font/

# Local environment/log noise.
.env
.env.*
*.log
