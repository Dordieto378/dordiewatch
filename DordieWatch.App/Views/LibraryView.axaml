<UserControl
    x:Class="DordieWatch.App.Views.LibraryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DordieWatch.App.ViewModels"
    xmlns:vlc="using:LibVLCSharp.Avalonia"
    x:DataType="vm:LibraryViewModel">

  <UserControl.Styles>
    <Style Selector="Button.clean">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.icon:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.poster">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.poster:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.poster:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.mediaTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.mediaTab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Grid Background="#050505">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="38,94,38,46" Spacing="0">
        <ItemsRepeater ItemsSource="{Binding Items}">
          <ItemsRepeater.Layout>
            <UniformGridLayout
                MinItemWidth="204"
                MinItemHeight="337"
                ItemsJustification="Start"
                ItemsStretch="None" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate DataType="vm:MediaCardViewModel">
              <Button
                  Classes="poster"
                  Command="{Binding $parent[UserControl].DataContext.OpenDetailsCommand}"
                  CommandParameter="{Binding}">
                <Grid Width="190" Height="315" RowDefinitions="285,30">
                  <Border Grid.Row="0" CornerRadius="7" ClipToBounds="True" Background="#171717">
                    <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                  </Border>

                  <ProgressBar
                      Grid.Row="0"
                      Value="{Binding Progress}"
                      Maximum="1"
                      Height="3"
                      VerticalAlignment="Bottom"
                      Foreground="#E50914"
                      Background="#4A4A4A" />

                  <TextBlock
                      Grid.Row="1"
                      Text="{Binding Title}"
                      FontSize="12"
                      FontWeight="SemiBold"
                      TextTrimming="CharacterEllipsis"
                      Margin="0,7,0,0" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </StackPanel>
    </ScrollViewer>

    <Border
        Height="68"
        VerticalAlignment="Top"
        Background="#00000000">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="28,0,28,0">
        <TextBlock
            Grid.Column="0"
            Text="DW!"
            Foreground="#E50914"
            FontFamily="avares://DordieWatch.App/Assets/Fonts#Moco"
            FontSize="38"
            FontWeight="Normal"
            VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="22" Margin="28,0,0,0" VerticalAlignment="Center">
          <Button
              Classes="mediaTab"
              Content="Anime"
              Foreground="{Binding AnimeNavForeground}"
              Command="{Binding SetCategoryCommand}"
              CommandParameter="anime" />
          <Button
              Classes="mediaTab"
              Content="Hentai"
              Foreground="{Binding HentaiNavForeground}"
              Command="{Binding SetCategoryCommand}"
              CommandParameter="hentai" />
        </StackPanel>

        <Button Grid.Column="3" Classes="icon" Margin="0,0,4,0">
          <Viewbox Width="32" Height="32">
            <Path Stroke="#FFFFFF" StrokeThickness="2.6" StrokeLineCap="Round" Fill="Transparent"
                  Data="M 19 19 L 29 29 M 22 13 A 9 9 0 1 1 21.99 12.99" />
          </Viewbox>
        </Button>

        <Button
            Grid.Column="4"
            Classes="icon"
            Command="{Binding RefreshCommand}"
            IsEnabled="{Binding !IsBusy}">
          <Viewbox Width="34" Height="34">
            <Path Stroke="#FFFFFF" StrokeThickness="2.35" StrokeLineCap="Round" Fill="Transparent"
                  Data="M 25 9 A 10 10 0 1 0 27 20 M 25 9 L 25 3 M 25 9 L 31 9" />
          </Viewbox>
        </Button>
      </Grid>
    </Border>

    <Grid
        x:Name="DetailsLayer"
        IsVisible="False"
        Opacity="0">
      <Button Classes="clean" Command="{Binding CloseDetailsCommand}" Background="#B2000000" />

      <ScrollViewer
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto"
          HorizontalAlignment="Center"
          VerticalAlignment="Stretch"
          Margin="0,28">
        <Border
            x:Name="DetailsPanel"
            Width="960"
            MinHeight="640"
            Background="#181818"
            CornerRadius="14"
            ClipToBounds="True"
            RenderTransformOrigin="50%,50%">
        <Border.RenderTransform>
          <ScaleTransform ScaleX="0.965" ScaleY="0.965" />
        </Border.RenderTransform>
        <Grid RowDefinitions="430,*">
          <Grid Grid.Row="0">
            <Image Source="{Binding SelectedBackdrop}" Stretch="UniformToFill" />
            <vlc:VideoView MediaPlayer="{Binding PreviewMediaPlayer}" />
            <Rectangle>
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Color="#E8000000" Offset="0" />
                  <GradientStop Color="#70000000" Offset="0.55" />
                  <GradientStop Color="#26000000" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#30000000" Offset="0.55" />
                  <GradientStop Color="#181818" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>

            <Button
                Classes="clean"
                Command="{Binding CloseDetailsCommand}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Width="40"
                Height="40">
              <Grid>
                <Ellipse Fill="#DD141414" />
                <Path Stroke="#FFFFFF" StrokeThickness="1.7" StrokeLineCap="Round"
                      Data="M 13 13 L 27 27 M 27 13 L 13 27" />
              </Grid>
            </Button>

            <StackPanel VerticalAlignment="Bottom" Margin="48,0,48,38" Spacing="16">
              <TextBlock
                  Text="{Binding SelectedTitle}"
                  FontSize="52"
                  FontWeight="Bold"
                  TextTrimming="CharacterEllipsis"
                  MaxWidth="760" />

              <Button
                  Command="{Binding PlaySelectedCommand}"
                  Background="#FFFFFF"
                  Foreground="#111111"
                  BorderThickness="0"
                  CornerRadius="4"
                  Padding="20,10"
                  HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Fill="#111111" Width="20" Height="20" Stretch="Uniform"
                        Data="M 3 1 L 17 9 L 3 17 Z" />
                  <TextBlock Text="Play" Foreground="#111111" FontWeight="Bold" FontSize="15" />
                </StackPanel>
              </Button>

              <TextBlock
                  Text="{Binding SelectedCountText}"
                  IsVisible="{Binding IsSelectedSeries}"
                  Foreground="#D4D4D4"
                  FontSize="14"
                  FontWeight="SemiBold" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" IsVisible="{Binding IsSelectedSeries}" RowDefinitions="Auto,*" Margin="48,28,48,42">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
              <TextBlock
                  Text="Episodes"
                  FontSize="24"
                  FontWeight="Bold"
                  VerticalAlignment="Center" />

              <ComboBox
                  Grid.Column="2"
                  IsVisible="{Binding HasEpisodeRanges}"
                  ItemsSource="{Binding EpisodeRanges}"
                  SelectedItem="{Binding SelectedEpisodeRange}"
                  Width="198"
                  Height="42"
                  Background="#242424"
                  BorderBrush="#585858"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="12,0">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:EpisodeRangeViewModel">
                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding SelectedEpisodes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:EpisodeCardViewModel">
                    <Button Classes="clean" Command="{Binding PlayCommand}" HorizontalAlignment="Stretch">
                      <Grid Height="124" ColumnDefinitions="60,150,*,96">
                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding Number}"
                            FontSize="20"
                            Foreground="#E4E4E4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <Border Grid.Column="1" Width="150" Height="84" CornerRadius="4" ClipToBounds="True" Background="#111111">
                          <Grid>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            <ProgressBar
                                Value="{Binding Progress}"
                                Maximum="1"
                                Height="4"
                                VerticalAlignment="Bottom"
                                Foreground="#E50914"
                                Background="#5A5A5A" />
                          </Grid>
                        </Border>

                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding Title}"
                            FontSize="15"
                            FontWeight="Bold"
                            Margin="18,0"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="3"
                            Text="{Binding RuntimeText}"
                            FontSize="14"
                            FontWeight="Bold"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
