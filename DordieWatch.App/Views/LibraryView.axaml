<UserControl
    x:Class="DordieWatch.App.Views.LibraryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DordieWatch.App.ViewModels"
    x:Name="Root"
    x:DataType="vm:LibraryViewModel">

  <UserControl.Styles>
    <Style Selector="Button.clean">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="Button.clean:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.clean:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.episode:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.episode:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.episode Border.episodePlayOverlay">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="Button.episode:pointerover Border.episodePlayOverlay">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <ContentPresenter
                Content="{TemplateBinding Content}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.icon:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.iconPop">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition
              Property="RenderTransform"
              Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.iconPop:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.13)" />
    </Style>

    <Style Selector="TextBox.searchInput">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="CaretBrush" Value="#FFFFFF" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="TextBox.searchInput /template/ Border#PART_BorderElement, TextBox.searchInput:pointerover /template/ Border#PART_BorderElement, TextBox.searchInput:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.poster">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="Button.poster:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.poster:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.mediaTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style Selector="Button.mediaTab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.rangeButtonSurface">
      <Setter Property="Background" Value="#242424" />
      <Setter Property="BorderBrush" Value="#5A5A5A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Border.rangeButtonSurface:pointerover">
      <Setter Property="Background" Value="#242424" />
      <Setter Property="BorderBrush" Value="#5A5A5A" />
    </Style>

    <Style Selector="Border.rangeButtonSurface:pressed">
      <Setter Property="Background" Value="#242424" />
      <Setter Property="BorderBrush" Value="#5A5A5A" />
    </Style>

    <Style Selector="Border.rangeOptionSurface">
      <Setter Property="Background" Value="#242424" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Border.rangeOptionSurface:pointerover">
      <Setter Property="Background" Value="#3A3A3A" />
    </Style>

    <Style Selector="Border.rangeOptionSurface:pressed">
      <Setter Property="Background" Value="#3A3A3A" />
    </Style>
  </UserControl.Styles>

  <Grid Background="#000000" ClipToBounds="True">
  <Grid
      x:Name="LibrarySurface"
      Background="#050505"
      RenderTransformOrigin="50%,50%">
    <Grid.RenderTransform>
      <ScaleTransform ScaleX="1" ScaleY="1" />
    </Grid.RenderTransform>
    <ScrollViewer
        x:Name="LibraryScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        SizeChanged="OnLibraryScrollViewerSizeChanged">
      <StackPanel Margin="38,94,38,46" Spacing="0">
        <ItemsRepeater
            x:Name="LibraryItemsRepeater"
            ItemsSource="{Binding Items}"
            Margin="0">
          <ItemsRepeater.Layout>
            <UniformGridLayout
                MinItemWidth="{Binding HomeGridItemWidth}"
                MinItemHeight="{Binding HomeGridItemHeight}"
                ItemsJustification="Start"
                ItemsStretch="None" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate DataType="vm:MediaCardViewModel">
              <Button
                  Classes="poster"
                  Command="{Binding $parent[UserControl].DataContext.OpenDetailsCommand}"
                  CommandParameter="{Binding}">
                <Grid
                    Width="{Binding $parent[UserControl].DataContext.HomePosterCardWidth}"
                    Height="{Binding $parent[UserControl].DataContext.HomePosterCardHeight}"
                    RowDefinitions="Auto,30">
                  <Border
                      Grid.Row="0"
                      Height="{Binding $parent[UserControl].DataContext.HomePosterImageHeight}"
                      CornerRadius="7"
                      ClipToBounds="True"
                      Background="#171717">
                    <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                  </Border>

                  <ProgressBar
                      IsVisible="{Binding HasProgress}"
                      Grid.Row="0"
                      Value="{Binding Progress}"
                      Maximum="1"
                      Height="3"
                      VerticalAlignment="Bottom"
                      Foreground="#E50914"
                      Background="#4A4A4A" />

                  <TextBlock
                      Grid.Row="1"
                      Text="{Binding Title}"
                      FontSize="12"
                      FontWeight="Normal"
                      TextTrimming="CharacterEllipsis"
                      Margin="0,7,0,0" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </StackPanel>
    </ScrollViewer>

    <Border
        Height="68"
        VerticalAlignment="Top"
        Background="#272727">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="38,0,28,0">
        <TextBlock
            Grid.Column="0"
            Text="DORDIEWATCH!"
            Foreground="#E50914"
            FontFamily="avares://DordieWatch.App/Assets/Fonts/Fruity Kiwi.otf#Fruity Kiwi"
            FontSize="26"
            FontWeight="Normal"
            VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="22" Margin="28,0,0,0" VerticalAlignment="Center">
          <Button
              Classes="mediaTab"
              Content="Anime"
              Foreground="{Binding AnimeNavForeground}"
              Command="{Binding SetCategoryCommand}"
              CommandParameter="anime" />
          <Button
              Classes="mediaTab"
              Content="Hentai"
              Foreground="{Binding HentaiNavForeground}"
              Command="{Binding SetCategoryCommand}"
              CommandParameter="hentai" />
        </StackPanel>

        <Grid
            x:Name="SearchSlot"
            Grid.Column="2"
            Height="56"
            Margin="24,0,4,0"
            VerticalAlignment="Center">
          <Grid
              x:Name="SearchControl"
              Width="{Binding SearchControlWidth}"
              MaxWidth="{Binding #SearchSlot.Bounds.Width}"
              Height="56"
              HorizontalAlignment="Right"
              ClipToBounds="True">
            <Grid.Transitions>
              <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.25">
                  <DoubleTransition.Easing>
                    <CubicEaseInOut />
                  </DoubleTransition.Easing>
                </DoubleTransition>
              </Transitions>
            </Grid.Transitions>

            <Border
                x:Name="SearchSurface"
                Background="#161616"
                CornerRadius="28"
                Opacity="{Binding SearchPanelOpacity}"
                IsHitTestVisible="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <Grid ColumnDefinitions="56,*">
              <Button
                  x:Name="SearchButton"
                  Classes="icon iconPop"
                  AutomationProperties.Name="Search"
                  ToolTip.Tip="Search"
                  Command="{Binding OpenSearchCommand}"
                  Click="OnSearchButtonClick"
                  VerticalAlignment="Center">
                <Viewbox Width="30" Height="30">
                  <Canvas Width="24" Height="24">
                    <Ellipse
                        Canvas.Left="1"
                        Canvas.Top="1"
                        Width="18"
                        Height="18"
                        Stroke="#FFFFFF"
                        StrokeThickness="2.4" />
                    <Path
                        Stroke="#FFFFFF"
                        StrokeThickness="2.4"
                        StrokeLineCap="Round"
                        Data="M 16 16 L 22 22" />
                  </Canvas>
                </Viewbox>
              </Button>

              <TextBox
                  x:Name="SearchTextBox"
                  Grid.Column="1"
                  Classes="searchInput"
                  AutomationProperties.Name="Search library"
                  Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsVisible="{Binding IsSearchOpen}"
                  VerticalAlignment="Center"
                  VerticalContentAlignment="Center"
                  Margin="-8,0,22,0"
                  KeyDown="OnSearchTextBoxKeyDown" />
            </Grid>
          </Grid>
        </Grid>

        <Button
            Grid.Column="3"
            Classes="icon iconPop"
            AutomationProperties.Name="Sync library"
            ToolTip.Tip="Sync library"
            Command="{Binding RefreshCommand}"
            IsEnabled="{Binding !IsBusy}">
          <Viewbox Width="30" Height="30">
            <Path
                Fill="#FFFFFF"
                Stretch="Uniform"
                Width="24"
                Height="24"
                Data="M 17.65 6.35 C 16.2 4.9 14.21 4 12 4 C 7.58 4 4 7.58 4 12 C 4 16.42 7.58 20 12 20 C 15.73 20 18.84 17.45 19.73 14 L 17.65 14 C 16.83 16.33 14.61 18 12 18 C 8.69 18 6 15.31 6 12 C 6 8.69 8.69 6 12 6 C 13.66 6 15.14 6.69 16.22 7.78 L 13 11 L 20 11 L 20 4 Z" />
          </Viewbox>
        </Button>
      </Grid>
    </Border>

    <Grid
        x:Name="DetailsLayer"
        IsVisible="False"
        PointerPressed="OnDetailsLayerPointerPressed">
      <Border x:Name="DetailsBackdrop" Background="#B2000000" Opacity="0" />

      <ScrollViewer
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,28">
        <Border
            x:Name="DetailsPanel"
            HorizontalAlignment="Center"
            Width="960"
            MinHeight="640"
            Background="#181818"
            CornerRadius="14"
            ClipToBounds="True"
            UseLayoutRounding="True">
        <Grid
            x:Name="DetailsContent"
            RowDefinitions="430,*"
            Background="#181818"
            ClipToBounds="True">
          <Border x:Name="DetailsHeader" Grid.Row="0" ClipToBounds="True" Background="#181818">
          <Grid>
            <Image Source="{Binding SelectedBackdrop}" Stretch="UniformToFill" RenderTransformOrigin="50%,50%">
              <Image.RenderTransform>
                <ScaleTransform ScaleX="1.075" ScaleY="1.075" />
              </Image.RenderTransform>
            </Image>
            <Rectangle>
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Color="#E8000000" Offset="0" />
                  <GradientStop Color="#70000000" Offset="0.55" />
                  <GradientStop Color="#26000000" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#26000000" Offset="0.38" />
                  <GradientStop Color="#B8181818" Offset="0.78" />
                  <GradientStop Color="#181818" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="150" VerticalAlignment="Bottom">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#00181818" Offset="0" />
                  <GradientStop Color="#E8181818" Offset="0.72" />
                  <GradientStop Color="#181818" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>

            <Button
                Classes="clean"
                Command="{Binding CloseDetailsCommand}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Width="40"
                Height="40">
              <Grid>
                <Ellipse Fill="#DD141414" />
                <Path Stroke="#FFFFFF" StrokeThickness="1.7" StrokeLineCap="Round"
                      Data="M 13 13 L 27 27 M 27 13 L 13 27" />
              </Grid>
            </Button>

            <StackPanel VerticalAlignment="Bottom" Margin="48,0,48,38" Spacing="16">
              <TextBlock
                  Text="{Binding SelectedTitle}"
                  FontSize="52"
                  FontWeight="Normal"
                  TextTrimming="CharacterEllipsis"
                  MaxWidth="760">
                <TextBlock.RenderTransform>
                  <TranslateTransform X="-58" Y="0" />
                </TextBlock.RenderTransform>
              </TextBlock>

              <Button
                  Click="OnPlaySelectedClick"
                  Background="#FFFFFF"
                  Foreground="#111111"
                  BorderThickness="0"
                  CornerRadius="4"
                  Padding="20,10"
                  HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Fill="#111111" Width="20" Height="20" Stretch="Uniform"
                        Data="M 3 1 L 17 9 L 3 17 Z" />
                  <TextBlock Text="Play" Foreground="#111111" FontWeight="Normal" FontSize="15" />
                </StackPanel>
              </Button>

            </StackPanel>
          </Grid>
          </Border>

          <Grid Grid.Row="1" IsVisible="{Binding IsSelectedSeries}" RowDefinitions="Auto,*" Margin="48,28,48,42">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
              <TextBlock
                  Text="Episodes"
                  FontSize="24"
                  FontWeight="Normal"
                  VerticalAlignment="Center" />

              <Grid
                  Grid.Column="2"
                  IsVisible="{Binding HasEpisodeRanges}"
                  Width="198"
                  Height="42">
                <Border
                    x:Name="EpisodeRangeButton"
                    Classes="rangeButtonSurface"
                    Width="198"
                    Height="42"
                    PointerPressed="OnEpisodeRangeButtonPointerPressed">
                  <Grid ColumnDefinitions="*,Auto" Margin="14,0,18,0">
                    <TextBlock
                        Text="{Binding SelectedEpisodeRange.Label}"
                        FontSize="15"
                        FontWeight="Normal"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Column="1" Width="18" Height="18" VerticalAlignment="Center" Margin="10,0,0,0">
                      <Path
                          Fill="#FFFFFF"
                          Width="11"
                          Height="8"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsEpisodeRangeDropdownClosed}"
                          Data="M 0 0 L 12 0 L 6 8 Z" />
                      <Path
                          Fill="#FFFFFF"
                          Width="11"
                          Height="8"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsEpisodeRangeDropdownOpen}"
                          Data="M 0 8 L 12 8 L 6 0 Z" />
                    </Grid>
                  </Grid>
                </Border>

                <Popup
                    IsOpen="{Binding IsEpisodeRangeDropdownOpen, Mode=TwoWay}"
                    PlacementTarget="{Binding #EpisodeRangeButton}"
                    Placement="BottomEdgeAlignedLeft"
                    VerticalOffset="2">
                  <Border
                      Width="198"
                      Background="#242424"
                      BorderBrush="#4F4F4F"
                      BorderThickness="1">
                    <ItemsControl ItemsSource="{Binding EpisodeRanges}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:EpisodeRangeViewModel">
                          <Border
                              Classes="rangeOptionSurface"
                              Height="42"
                              Tag="{Binding}"
                              PointerPressed="OnEpisodeRangeOptionPointerPressed">
                            <TextBlock
                                Text="{Binding Label}"
                                Foreground="#FFFFFF"
                                FontSize="14"
                                FontWeight="Normal"
                                VerticalAlignment="Center"
                                Margin="14,0" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </Popup>
              </Grid>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding SelectedEpisodes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:EpisodeCardViewModel">
                    <Button
                        Classes="clean episode"
                        Tag="{Binding}"
                        Click="OnEpisodePlayClick"
                        HorizontalAlignment="Stretch">
                      <Border Background="{Binding RowBackground}" BorderBrush="#363636" BorderThickness="0,0,0,1">
                        <Grid Height="132" ColumnDefinitions="60,150,*,96">
                          <TextBlock
                              Grid.Column="0"
                              Text="{Binding Number}"
                              FontSize="24"
                              Foreground="#DCDCDC"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />

                          <Border Grid.Column="1" Width="150" Height="84" CornerRadius="4" ClipToBounds="True" Background="#111111">
                            <Grid>
                              <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                              <Border Classes="episodePlayOverlay" Background="#26000000">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="54" Height="54">
                                  <Ellipse Stroke="#F5FFFFFF" StrokeThickness="1.7" Fill="#22000000" />
                                  <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0">
                                    <Path Fill="#FFFFFF" Stretch="Uniform"
                                          Data="M 0 0 L 18 11 L 0 22 Z" />
                                  </Viewbox>
                                </Grid>
                              </Border>
                              <ProgressBar
                                  IsVisible="{Binding HasProgress}"
                                  Value="{Binding Progress}"
                                  Maximum="1"
                                  Height="4"
                                  VerticalAlignment="Bottom"
                                  Foreground="#E50914"
                                  Background="#5A5A5A" />
                            </Grid>
                          </Border>

                          <StackPanel Grid.Column="2" Margin="18,0,12,0" VerticalAlignment="Center" Spacing="7">
                            <TextBlock
                                Text="{Binding Title}"
                                FontSize="16"
                                FontWeight="Normal" />
                          </StackPanel>

                          <TextBlock
                              Grid.Column="3"
                              Text="{Binding RuntimeText}"
                              FontSize="16"
                              FontWeight="Normal"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
        <Grid
            x:Name="DetailsTransitionVisual"
            ZIndex="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsVisible="False"
            IsHitTestVisible="False"
            RenderTransformOrigin="50%,50%">
          <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.965" ScaleY="0.965" />
          </Grid.RenderTransform>
          <Border Background="#181818" CornerRadius="14" />
          <Image
              x:Name="DetailsTransitionSnapshot"
              Stretch="Fill"
              Opacity="0" />
        </Grid>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>

  <Border
      x:Name="PlaybackTransitionLayer"
      ZIndex="100"
      Background="#000000"
      Opacity="0"
      IsHitTestVisible="False" />
  </Grid>
</UserControl>
